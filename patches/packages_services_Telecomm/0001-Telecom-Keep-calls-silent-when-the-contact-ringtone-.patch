From 8f4d8efe19074415f21ade27d030c46ce82811ef Mon Sep 17 00:00:00 2001
From: MikolajQ <mikolaj.q@wp.pl>
Date: Sat, 7 Nov 2026 11:42:19 +0100
Subject: [PATCH] Telecom: Keep calls silent when the contact ringtone is
 "None"

A contact ringtone set to "None" is stored as an empty CUSTOM_RINGTONE,
which CallerInfo maps to Uri.EMPTY. RingtoneFactory passed it on to
RingtoneManager#getRingtone(), which returns a Ringtone that can't open
the empty URI. Ringtone#play() then has neither a local nor a remote
player and plays R.raw.fallbackring, so the call rings audibly.

Return no ringtone for Uri.EMPTY. AsyncRingtonePlayer already skips
playback for a null ringtone and the call still vibrates.

Assisted-by: LLM
---
 .../android/server/telecom/RingtoneFactory.java   |  9 +++++++++
 .../server/telecom/tests/RingtoneFactoryTest.java | 15 +++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/src/com/android/server/telecom/RingtoneFactory.java b/src/com/android/server/telecom/RingtoneFactory.java
index fb6843d..0ac8fe7 100644
--- a/src/com/android/server/telecom/RingtoneFactory.java
+++ b/src/com/android/server/telecom/RingtoneFactory.java
@@ -74,6 +74,15 @@ public class RingtoneFactory {
         Uri ringtoneUri = incomingCall.getRingtone();
         Ringtone ringtone = null;
 
+        if (Uri.EMPTY.equals(ringtoneUri)) {
+            // The contact's ringtone is set to "None": CallerInfo maps an empty CUSTOM_RINGTONE
+            // to Uri.EMPTY. Don't create a Ringtone for it - the empty URI can't be opened, so
+            // Ringtone#play() would play R.raw.fallbackring instead of staying silent. Without a
+            // ringtone AsyncRingtonePlayer skips playback and the call still vibrates.
+            Log.i(this, "getRingtone: contact ringtone is silent.");
+            return new Pair(ringtoneUri, null);
+        }
+
         if (ringtoneUri != null && userContext != null) {
             if (currentUserOwnsRingtone(ringtoneUri, incomingCall)) {
                 // Ringtone URI is explicitly specified and owned by the current user - try to
diff --git a/tests/src/com/android/server/telecom/tests/RingtoneFactoryTest.java b/tests/src/com/android/server/telecom/tests/RingtoneFactoryTest.java
index 6658f7f..28c86e9 100644
--- a/tests/src/com/android/server/telecom/tests/RingtoneFactoryTest.java
+++ b/tests/src/com/android/server/telecom/tests/RingtoneFactoryTest.java
@@ -18,6 +18,7 @@ package com.android.server.telecom.tests;
 
 import static org.junit.Assert.assertEquals;
 import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNull;
 import static org.mockito.Mockito.spy;
 import static org.mockito.Mockito.when;
 
@@ -108,4 +109,18 @@ public class RingtoneFactoryTest extends TelecomTestCase {
         Pair<Uri, Ringtone> ringtonePair = ringtoneFactory.getRingtone(mockCall, null, false);
         assertNotEquals(mockCustomRingtoneUri, ringtonePair.first);
     }
+
+    @SmallTest
+    @Test
+    public void testSilentContactRingtoneReturnsNoRingtone() throws Exception {
+        when(mockCall.getAssociatedUser()).thenReturn(new UserHandle(0));
+
+        // Contact ringtone set to "None" (empty CUSTOM_RINGTONE maps to Uri.EMPTY):
+        when(mockCall.getRingtone()).thenReturn(Uri.EMPTY);
+
+        // Ensure no ringtone is created and the default ringtone is not used instead:
+        Pair<Uri, Ringtone> ringtonePair = ringtoneFactory.getRingtone(mockCall, null, false);
+        assertEquals(Uri.EMPTY, ringtonePair.first);
+        assertNull(ringtonePair.second);
+    }
 }
\ No newline at end of file

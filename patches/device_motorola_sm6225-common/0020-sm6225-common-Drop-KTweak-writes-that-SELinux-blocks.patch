From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MikolajQ <mikolaj.q@wp.pl>
Date: Tue, 13 Oct 2026 19:16:51 +0200
Subject: [PATCH] sm6225-common: Drop KTweak writes that SELinux blocks

vendor_init may not write proc_sched, proc_perf or plain proc nodes, so
the kernel.sched_*, perf_cpu_time_max_percent, printk_devkmsg and
vfs_cache_pressure writes added with KTweak have always failed (avc
denials at boot; on rhode 13.10.2026 sched_latency_ns is 10 ms,
sched_child_runs_first 0, perf_cpu_time_max_percent 1, printk_devkmsg
ratelimit). sched_min_granularity_ns does not even exist without
SCHED_DEBUG. Keep only the writes that work: dirty_writeback_centisecs,
tcp_fastopen and tcp_syncookies. No behaviour change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Dr8X39PngEfThUaxTxyj9B
---
 init/init.target.rc | 17 +++--------------
 1 file changed, 3 insertions(+), 14 deletions(-)

diff --git a/init/init.target.rc b/init/init.target.rc
index 5d49fa8..d9856c6 100755
--- a/init/init.target.rc
+++ b/init/init.target.rc
@@ -82,23 +82,12 @@ on boot
     setprop vendor.usb.dpl.inst.name "dpl"
     setprop vendor.usb.qdss.inst.name "qdss"
     setprop vendor.usb.controller 4e00000.dwc3
-    # KTweak
-    write /proc/sys/kernel/perf_cpu_time_max_percent 5
-    #write /proc/sys/kernel/sched_autogroup_enabled 1
-    write /proc/sys/kernel/sched_child_runs_first 1
-    write /proc/sys/kernel/sched_tunable_scaling 0
-    write /proc/sys/kernel/sched_latency_ns 4000000
-    write /proc/sys/kernel/sched_min_granularity_ns 500000
-    #write /proc/sys/kernel/sched_wakeup_granularity_ns 2000000
-    #write /proc/sys/kernel/sched_migration_cost_ns 5000000 sultan says 0 is better
-    #write /proc/sys/kernel/sched_min_task_util_for_colocation 0
-    #write /proc/sys/kernel/sched_nr_migrate 32
-    #write /proc/sys/kernel/sched_schedstats 0 no node in my kernel
-    write /proc/sys/kernel/printk_devkmsg off
+    # KTweak: only the knobs vendor_init is allowed to write. kernel.sched_*,
+    # perf_cpu_time_max_percent, printk_devkmsg and vm.vfs_cache_pressure are
+    # denied by SELinux (proc_sched, proc_perf, proc) and never took effect.
     write /proc/sys/vm/dirty_writeback_centisecs 3000
     write /proc/sys/net/ipv4/tcp_fastopen 3
     write /proc/sys/net/ipv4/tcp_syncookies 0
-    write /proc/sys/vm/vfs_cache_pressure 100
 
 #Load WLAN driver
     insmod /vendor/lib/modules/qca_cld3_wlan.ko
-- 
2.56.0


diff --git a/NfcNci/src/com/android/nfc/cardemulation/CardEmulationManager.java b/NfcNci/src/com/android/nfc/cardemulation/CardEmulationManager.java
index 8d81e64..4f61cf2 100644
--- a/NfcNci/src/com/android/nfc/cardemulation/CardEmulationManager.java
+++ b/NfcNci/src/com/android/nfc/cardemulation/CardEmulationManager.java
@@ -436,6 +436,7 @@ public class CardEmulationManager implements RegisteredServicesCache.Callback,
         if (DBG) Log.d(TAG, "onNfcEnabled");
         // for HCE
         mAidCache.onNfcEnabled();
+        mHostEmulationManager.onNfcEnabled();
         // for HCE-F
         mT3tIdentifiersCache.onNfcEnabled();
     }
@@ -444,6 +445,7 @@ public class CardEmulationManager implements RegisteredServicesCache.Callback,
         if (DBG) Log.d(TAG, "onNfcDisabled");
         // for HCE
         mAidCache.onNfcDisabled();
+        mHostEmulationManager.onNfcDisabled();
         // for HCE-F
         mHostNfcFEmulationManager.onNfcDisabled();
         mNfcFServicesCache.onNfcDisabled();
diff --git a/NfcNci/src/com/android/nfc/cardemulation/HostEmulationManager.java b/NfcNci/src/com/android/nfc/cardemulation/HostEmulationManager.java
index d199353..f2817d2 100644
--- a/NfcNci/src/com/android/nfc/cardemulation/HostEmulationManager.java
+++ b/NfcNci/src/com/android/nfc/cardemulation/HostEmulationManager.java
@@ -210,6 +210,10 @@ public class HostEmulationManager {
     // latency.
     Messenger mPaymentService;
     boolean mPaymentServiceBound = false;
+    // The payment service is only kept bound while NFC is enabled. Otherwise
+    // the binding keeps the payment app at a visible oom_adj, so it is never
+    // cached or frozen although it cannot be used for a transaction.
+    boolean mNfcEnabled = false;
 
     boolean mEnableObserveModeAfterTransaction = false;
     boolean mEnableObserveModeOnFieldOff = false;
@@ -395,7 +399,7 @@ public class HostEmulationManager {
                     resetActiveService();
                 }
 
-                if (service != null && service.getComponentName() != null) {
+                if (mNfcEnabled && service != null && service.getComponentName() != null) {
                     bindPaymentServiceLocked(service.getUserId(), service.getComponentName());
                 } else {
                     unbindPaymentServiceLocked();
@@ -404,6 +408,41 @@ public class HostEmulationManager {
         });
     }
 
+    /**
+     *  NFC enabled: bind the preferred payment service so that it is ready for a transaction
+     */
+    public void onNfcEnabled() {
+        mHandler.post(() -> {
+            synchronized (mLock) {
+                mNfcEnabled = true;
+                if (mPaymentServiceBound) {
+                    return;
+                }
+                ComponentNameAndUser service = mAidCache.getPreferredPaymentService();
+                if (service != null && service.getComponentName() != null) {
+                    Log.d(TAG, "onNfcEnabled: binding payment service");
+                    bindPaymentServiceLocked(service.getUserId(), service.getComponentName());
+                }
+            }
+        });
+    }
+
+    /**
+     *  NFC disabled: drop the persistent payment service binding
+     */
+    public void onNfcDisabled() {
+        mHandler.post(() -> {
+            synchronized (mLock) {
+                mNfcEnabled = false;
+                if (mPaymentServiceBound) {
+                    Log.d(TAG, "onNfcDisabled: unbinding payment service");
+                }
+                resetActiveService();
+                unbindPaymentServiceLocked();
+            }
+        });
+    }
+
     private Pair<Messenger, ComponentName> bindToForegroundServiceOrDefaultForPollingLoop() {
         ComponentNameAndUser preferredService = mAidCache.getPreferredService();
         int preferredServiceUserId = preferredService.getUserId();

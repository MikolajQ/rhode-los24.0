     }
 
     @After
@@ -266,6 +268,65 @@ public class HostEmulationManagerTest {
         assertNotNull(mServiceConnectionArgumentCaptor.getValue());
     }
 
+    @Test
+    public void testOnPreferredPaymentServiceChanged_nfcDisabled() {
+        mHostEmulationManager.mNfcEnabled = false;
+
+        mHostEmulationManager.onPreferredPaymentServiceChanged(
+                new ComponentNameAndUser(USER_ID, WALLET_PAYMENT_SERVICE));
+        mTestableLooper.processAllMessages();
+
+        verify(mContext, never()).bindServiceAsUser(any(), any(), anyInt(), any());
+        assertFalse(mHostEmulationManager.mPaymentServiceBound);
+    }
+
+    @Test
+    public void testOnNfcDisabled_unbindsPaymentService() {
+        mHostEmulationManager.mPaymentServiceBound = true;
+
+        mHostEmulationManager.onNfcDisabled();
+        mTestableLooper.processAllMessages();
+
+        verify(mContext).unbindService(eq(mHostEmulationManager.getPaymentConnection()));
+        assertFalse(mHostEmulationManager.mPaymentServiceBound);
+        assertFalse(mHostEmulationManager.mNfcEnabled);
+    }
+
+    @Test
+    public void testOnNfcEnabled_bindsPreferredPaymentService() {
+        when(mContext.bindServiceAsUser(any(), any(), anyInt(), any())).thenReturn(true);
+        when(mRegisteredAidCache.getPreferredPaymentService())
+                .thenReturn(new ComponentNameAndUser(USER_ID, WALLET_PAYMENT_SERVICE));
+        mHostEmulationManager.mNfcEnabled = false;
+
+        mHostEmulationManager.onNfcEnabled();
+        mTestableLooper.processAllMessages();
+
+        verify(mContext)
+                .bindServiceAsUser(
+                        mIntentArgumentCaptor.capture(),
+                        any(),
+                        eq(
+                                Context.BIND_AUTO_CREATE
+                                        | Context.BIND_ALLOW_BACKGROUND_ACTIVITY_STARTS),
+                        eq(UserHandle.of(USER_ID)));
+        assertEquals(WALLET_PAYMENT_SERVICE, mIntentArgumentCaptor.getValue().getComponent());
+        assertTrue(mHostEmulationManager.mPaymentServiceBound);
+        assertTrue(mHostEmulationManager.mNfcEnabled);
+    }
+
+    @Test
+    public void testOnNfcEnabled_noPreferredPaymentService() {
+        mHostEmulationManager.mNfcEnabled = false;
+
+        mHostEmulationManager.onNfcEnabled();
+        mTestableLooper.processAllMessages();
+
+        verify(mContext, never()).bindServiceAsUser(any(), any(), anyInt(), any());
+        assertFalse(mHostEmulationManager.mPaymentServiceBound);
+        assertTrue(mHostEmulationManager.mNfcEnabled);
+    }
+

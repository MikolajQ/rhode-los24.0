From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Galt <johngaltfirstrun@gmail.com>
Date: Fri, 5 Jun 2026 08:41:53 -0400
Subject: [PATCH 40/42] surfaceflinger: vrr: apply idle signal to vrr rate
 policy

Allows signals.idle to reach getRankedFrameRatesLocked, allowing idle
refresh rate path to select anchor rates. Previously only the overlay
was updated, making idle signal always false on vrr.

[MikolajQ: Ported to Android 17: promotePacesetterDisplayLocked() was folded into promotePacesetterDisplay()]
---
 .../surfaceflinger/Scheduler/Scheduler.cpp    | 20 ++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/services/surfaceflinger/Scheduler/Scheduler.cpp b/services/surfaceflinger/Scheduler/Scheduler.cpp
index db6e47d..0f23653 100644
--- a/services/surfaceflinger/Scheduler/Scheduler.cpp
+++ b/services/surfaceflinger/Scheduler/Scheduler.cpp
@@ -173,13 +173,15 @@ void Scheduler::initializeIdleTimer(PhysicalDisplayId displayId) {
                                     kernelIdleTimerCallback(displayId, TimerState::Expired);
                                 }},
              .vrr = {.onReset =
-                             [this, displayId] {
-                                 mSchedulerCallback.vrrDisplayIdle(displayId, false);
-                             },
-                     .onExpired =
-                             [this, displayId] {
-                                 mSchedulerCallback.vrrDisplayIdle(displayId, true);
-                             }}});
+                              [this, displayId] {
+                                  applyPolicy(&Policy::idleTimers, TimerState::Reset, displayId);
+                                  mSchedulerCallback.vrrDisplayIdle(displayId, false);
+                              },
+                      .onExpired =
+                              [this, displayId] {
+                                  applyPolicy(&Policy::idleTimers, TimerState::Expired, displayId);
+                                  mSchedulerCallback.vrrDisplayIdle(displayId, true);
+                              }}});
 }
 
 bool Scheduler::designatePacesetterDisplay() {
@@ -1410,10 +1412,14 @@ void Scheduler::promotePacesetterDisplay(PromotionParams params,
                                     }},
                  .vrr = {.onReset =
                                  [this, pacesetterId] {
+                                     applyPolicy(&Policy::idleTimers, TimerState::Reset,
+                                                 *pacesetterId);
                                      mSchedulerCallback.vrrDisplayIdle(*pacesetterId, false);
                                  },
                          .onExpired =
                                  [this, pacesetterId] {
+                                     applyPolicy(&Policy::idleTimers, TimerState::Expired,
+                                                 *pacesetterId);
                                      mSchedulerCallback.vrrDisplayIdle(*pacesetterId, true);
                                  }}});
 

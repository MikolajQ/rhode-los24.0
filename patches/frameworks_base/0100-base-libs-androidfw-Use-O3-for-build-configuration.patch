From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akane Beneckendorff <akane@akanework.org>
Date: Mon, 23 Oct 2023 20:54:35 +0800
Subject: [PATCH 100/220] base: libs: androidfw: Use '-O3' for build
 configuration

Signed-off-by: Akane Beneckendorff <akane@akanework.org>
---
 libs/androidfw/Android.bp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/libs/androidfw/Android.bp b/libs/androidfw/Android.bp
index 664ca38cc..4411ba5d3 100644
--- a/libs/androidfw/Android.bp
+++ b/libs/androidfw/Android.bp
@@ -51,16 +51,17 @@ cc_defaults {
     name: "libandroidfw_defaults",
     cpp_std: "gnu++2b",
     cflags: [
+        "-O3",
         "-Werror",
         "-Wunreachable-code",
     ],
     target: {
         windows: {
             // The Windows compiler warns incorrectly for value initialization with {}.
-            cppflags: ["-Wno-missing-field-initializers"],
+            cppflags: ["-O3", "-Wno-missing-field-initializers"],
         },
         host: {
-            cflags: ["-DSTATIC_ANDROIDFW_FOR_TOOLS"],
+            cflags: ["-O3", "-DSTATIC_ANDROIDFW_FOR_TOOLS"],
         },
     },
 }
@@ -207,6 +208,7 @@ cc_test {
     host_supported: true,
     defaults: ["libandroidfw_defaults"],
     cppflags: [
+        "-O3",
         // This is to suppress warnings/errors from gtest
         "-Wno-unnamed-type-template-args",
     ],

From 0d851adf589e6a80ce3aa3bc8080252b1b901d37 Mon Sep 17 00:00:00 2001
From: MikolajQ <mikolaj.q@wp.pl>
Date: Sat, 31 Oct 2026 22:52:04 +0100
Subject: [PATCH] DefaultDeviceEffectsApplier: Apply disableTapToWake

A bedtime mode that takes the device off the air and turns location off
still leaves the touch panel scanning for the double tap gesture all
night. On devices where the panel can sleep with the gesture disabled
that is a drain the mode could turn off: on rhode, nights in airplane
mode with the gesture enabled drew roughly 1-3 mA more.

ZenDeviceEffects already carries disableTapToWake, but the default
applier ignores it. Apply it to double tap to wake of the current user,
with the same rules as the location effect: it only undoes what the
mode did, does not revert a manual change when the effects are applied
again, persists whether the mode made the change, and does nothing on
devices without double tap to wake support.

Assisted-by: LLM
Change-Id: I2198f774edfc974e94fcd676aa55bbf18f450e77
---
 .../DefaultDeviceEffectsApplier.java          | 46 ++++++++++++
 .../DefaultDeviceEffectsApplierTest.java      | 73 +++++++++++++++++++
 2 files changed, 119 insertions(+)

diff --git a/services/core/java/com/android/server/notification/DefaultDeviceEffectsApplier.java b/services/core/java/com/android/server/notification/DefaultDeviceEffectsApplier.java
index a6fe5d0bfa78..bf6d7ce0d306 100644
--- a/services/core/java/com/android/server/notification/DefaultDeviceEffectsApplier.java
+++ b/services/core/java/com/android/server/notification/DefaultDeviceEffectsApplier.java
@@ -69,6 +69,9 @@ public class DefaultDeviceEffectsApplier implements DeviceEffectsApplier {
     private static final String AIRPLANE_MODE_OWNED_SETTING = "zen_effect_airplane_mode_owned";
     // Value: id of the user whose location the mode turned off, plus one; 0 if none.
     private static final String LOCATION_OWNED_SETTING = "zen_effect_location_owned_user";
+    // Value: id of the user whose double tap to wake the mode turned off, plus one; 0 if none.
+    private static final String DOUBLE_TAP_TO_WAKE_OWNED_SETTING =
+            "zen_effect_double_tap_to_wake_owned_user";
 
     private final Context mContext;
     private final ColorDisplayManager mColorDisplayManager;
@@ -115,6 +118,7 @@ public class DefaultDeviceEffectsApplier implements DeviceEffectsApplier {
                     maybeMinimizeRadioUsage(effects.shouldMinimizeRadioUsage());
                     maybeDisableLocation(effects.getExtraEffects().contains(
                             ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION));
+                    maybeDisableTapToWake(effects.shouldDisableTapToWake());
                 });
 
         mLastAppliedEffects = effects;
@@ -232,6 +236,48 @@ public class DefaultDeviceEffectsApplier implements DeviceEffectsApplier {
         }
     }
 
+    /**
+     * Turns double tap to wake off for the current user when the effect starts and back on when it
+     * ends, but only if it was on before. With double tap to wake off, the touch panel can be put
+     * to sleep instead of watching for gestures while the screen is off.
+     */
+    protected void maybeDisableTapToWake(boolean shouldDisableTapToWake) {
+        if (!mContext.getResources().getBoolean(
+                com.android.internal.R.bool.config_supportDoubleTapWake)) {
+            return;
+        }
+        ContentResolver cr = mContext.getContentResolver();
+        int ownedUser = Settings.Global.getInt(cr, DOUBLE_TAP_TO_WAKE_OWNED_SETTING, 0) - 1;
+        boolean wasApplied = mLastAppliedEffects.shouldDisableTapToWake();
+        try {
+            if (shouldDisableTapToWake) {
+                // Re-applying the same effects (e.g. another mode changed) or a reboot while the
+                // mode is active must not undo a manual change.
+                if (wasApplied || ownedUser >= 0) {
+                    return;
+                }
+                int user = ActivityManager.getCurrentUser();
+                if (Settings.Secure.getIntForUser(
+                        cr, Settings.Secure.DOUBLE_TAP_TO_WAKE, 0, user) == 0) {
+                    return;
+                }
+                traceApplyDeviceEffect("disableTapToWake", true);
+                Settings.Global.putInt(cr, DOUBLE_TAP_TO_WAKE_OWNED_SETTING, user + 1);
+                Settings.Secure.putIntForUser(cr, Settings.Secure.DOUBLE_TAP_TO_WAKE, 0, user);
+            } else if (ownedUser >= 0) {
+                Settings.Global.putInt(cr, DOUBLE_TAP_TO_WAKE_OWNED_SETTING, 0);
+                if (Settings.Secure.getIntForUser(
+                        cr, Settings.Secure.DOUBLE_TAP_TO_WAKE, 0, ownedUser) == 0) {
+                    traceApplyDeviceEffect("disableTapToWake", false);
+                    Settings.Secure.putIntForUser(
+                            cr, Settings.Secure.DOUBLE_TAP_TO_WAKE, 1, ownedUser);
+                }
+            }
+        } catch (Exception e) {
+            Slog.e(TAG, "Could not change double tap to wake", e);
+        }
+    }
+
     protected void maybeSuppressAmbientDisplay(boolean shouldSuppressAmbientDisplay) {
         if (mLastAppliedEffects.shouldSuppressAmbientDisplay() != shouldSuppressAmbientDisplay) {
             try {
diff --git a/services/tests/uiservicestests/src/com/android/server/notification/DefaultDeviceEffectsApplierTest.java b/services/tests/uiservicestests/src/com/android/server/notification/DefaultDeviceEffectsApplierTest.java
index f558977a9538..868ec4cf5e44 100644
--- a/services/tests/uiservicestests/src/com/android/server/notification/DefaultDeviceEffectsApplierTest.java
+++ b/services/tests/uiservicestests/src/com/android/server/notification/DefaultDeviceEffectsApplierTest.java
@@ -109,6 +109,10 @@ public class DefaultDeviceEffectsApplierTest {
         when(mWallpaperManager.isWallpaperSupported()).thenReturn(true);
         Settings.Global.putInt(mContext.getContentResolver(), "zen_effect_airplane_mode_owned", 0);
         Settings.Global.putInt(mContext.getContentResolver(), "zen_effect_location_owned_user", 0);
+        Settings.Global.putInt(mContext.getContentResolver(),
+                "zen_effect_double_tap_to_wake_owned_user", 0);
+        mContext.getOrCreateTestableResources().addOverride(
+                com.android.internal.R.bool.config_supportDoubleTapWake, true);
 
         mApplier = new DefaultDeviceEffectsApplier(mContext);
         verify(mWallpaperManager).isWallpaperSupported();
@@ -410,6 +414,9 @@ public class DefaultDeviceEffectsApplierTest {
             .addExtraEffect(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION)
             .build();
 
+    private static final ZenDeviceEffects DISABLE_TAP_TO_WAKE =
+            new ZenDeviceEffects.Builder().setShouldDisableTapToWake(true).build();
+
     private void setAirplaneMode(boolean on) {
         Settings.Global.putInt(mContext.getContentResolver(), Settings.Global.AIRPLANE_MODE_ON,
                 on ? 1 : 0);
@@ -511,4 +518,70 @@ public class DefaultDeviceEffectsApplierTest {
 
         verify(mLocationManager, never()).setLocationEnabledForUser(anyBoolean(), any());
     }
+
+    private void setDoubleTapToWake(boolean on) {
+        Settings.Secure.putIntForUser(mContext.getContentResolver(),
+                Settings.Secure.DOUBLE_TAP_TO_WAKE, on ? 1 : 0, ActivityManager.getCurrentUser());
+    }
+
+    private boolean isDoubleTapToWakeOn() {
+        return Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                Settings.Secure.DOUBLE_TAP_TO_WAKE, 0, ActivityManager.getCurrentUser()) != 0;
+    }
+
+    @Test
+    public void apply_disableTapToWake_togglesDoubleTapToWake() {
+        setDoubleTapToWake(true);
+
+        mApplier.apply(DISABLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+        assertThat(isDoubleTapToWakeOn()).isFalse();
+
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
+
+    @Test
+    public void apply_disableTapToWake_alreadyOff_leavesItOff() {
+        setDoubleTapToWake(false);
+
+        mApplier.apply(DISABLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+
+        assertThat(isDoubleTapToWakeOn()).isFalse();
+    }
+
+    @Test
+    public void apply_disableTapToWake_turnedOnByUser_notTurnedOffAgain() {
+        setDoubleTapToWake(true);
+        mApplier.apply(DISABLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+
+        // The user turns double tap to wake on, then an unrelated change re-applies the effects.
+        setDoubleTapToWake(true);
+        mApplier.apply(DISABLE_TAP_TO_WAKE, ORIGIN_APP);
+
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
+
+    @Test
+    public void apply_disableTapToWake_onBootAfterModeEnded_turnsItOn() {
+        setDoubleTapToWake(true);
+        mApplier.apply(DISABLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+
+        // Reboot: the mode ended while the device was off.
+        mApplier = new DefaultDeviceEffectsApplier(mContext);
+        mApplier.apply(NO_EFFECTS, ORIGIN_INIT);
+
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
+
+    @Test
+    public void apply_disableTapToWake_notSupported_doesNothing() {
+        mContext.getOrCreateTestableResources().addOverride(
+                com.android.internal.R.bool.config_supportDoubleTapWake, false);
+        setDoubleTapToWake(true);
+
+        mApplier.apply(DISABLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
 }

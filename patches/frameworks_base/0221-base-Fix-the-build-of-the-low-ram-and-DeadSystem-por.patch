From 3e951dfe2dcd9f724a8e4785a1170d0597296eea Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miko=C5=82aj?= <mikolaj.q@wp.pl>
Date: Thu, 15 Oct 2026 17:55:29 +0000
Subject: [PATCH] base: Fix the build of the low-ram and DeadSystem ports on
 Android 17

hwui only uses the low-ram policy now, so mark the others unused; Android
17 already lists DROPBOX_SERVICE among the optional services, so drop the
duplicate case label.

Change-Id: I56b097ae42b594b87792daeb82f1fc4f0e657638
---
 core/java/android/app/SystemServiceRegistry.java | 4 ----
 libs/hwui/MemoryPolicy.cpp                       | 6 +++---
 2 files changed, 3 insertions(+), 7 deletions(-)

diff --git a/core/java/android/app/SystemServiceRegistry.java b/core/java/android/app/SystemServiceRegistry.java
index e5b51f452..46cce1b41 100644
--- a/core/java/android/app/SystemServiceRegistry.java
+++ b/core/java/android/app/SystemServiceRegistry.java
@@ -2318,10 +2318,6 @@ public final class SystemServiceRegistry {
                 case Context.PERSISTENT_DATA_BLOCK_SERVICE:
                 case Context.OEM_LOCK_SERVICE:
                     return null;
-                case Context.DROPBOX_SERVICE:
-                    // If the Dropbox service is missing, we don't want to trigger a WTF, because
-                    // this can lead to an infinite loop in WTF reporting to Dropbox.
-                    return null;
                 case Context.VCN_MANAGEMENT_SERVICE:
                     if (!hasSystemFeatureOpportunistic(ctx,
                             PackageManager.FEATURE_TELEPHONY_SUBSCRIPTION)) {
diff --git a/libs/hwui/MemoryPolicy.cpp b/libs/hwui/MemoryPolicy.cpp
index 26ded3291..5e5fe8660 100644
--- a/libs/hwui/MemoryPolicy.cpp
+++ b/libs/hwui/MemoryPolicy.cpp
@@ -25,8 +25,8 @@
 
 namespace android::uirenderer {
 
-constexpr static MemoryPolicy sDefaultMemoryPolicy;
-constexpr static MemoryPolicy sPersistentOrSystemPolicy{
+[[maybe_unused]] constexpr static MemoryPolicy sDefaultMemoryPolicy;
+[[maybe_unused]] constexpr static MemoryPolicy sPersistentOrSystemPolicy{
         .contextTimeout = 10_s,
         .minimumResourceRetention = 1_s,
         .maximumResourceRetention = 10_s,
@@ -37,7 +37,7 @@ constexpr static MemoryPolicy sLowRamPolicy{
         .useAlternativeUiHidden = true,
         .purgeScratchOnly = false,
 };
-constexpr static MemoryPolicy sExtremeLowRam{
+[[maybe_unused]] constexpr static MemoryPolicy sExtremeLowRam{
         .initialMaxSurfaceAreaScale = 0.2f,
         .surfaceSizeMultiplier = 5 * 4.0f,
         .backgroundRetentionPercent = 0.2f,
-- 
2.43.0


@@ -39,6 +39,7 @@ import static org.mockito.Mockito.verify;
 import static org.mockito.Mockito.verifyNoMoreInteractions;
 import static org.mockito.Mockito.when;
 
+import android.app.ActivityManager;
 import android.app.KeyguardManager;
 import android.app.UiModeManager;
 import android.app.WallpaperManager;
@@ -46,9 +47,15 @@ import android.content.BroadcastReceiver;
 import android.content.Intent;
 import android.content.IntentFilter;
 import android.hardware.display.ColorDisplayManager;
+import android.location.LocationManager;
+import android.net.ConnectivityManager;
 import android.os.PowerManager;
+import android.os.UserHandle;
 import android.platform.test.flag.junit.SetFlagsRule;
+import android.provider.Settings;
 import android.service.notification.ZenDeviceEffects;
+import android.telecom.TelecomManager;
+import android.telephony.TelephonyManager;
 import android.testing.TestableContext;
 
 import androidx.test.InstrumentationRegistry;
@@ -81,6 +88,9 @@ public class DefaultDeviceEffectsApplierTest {
     @Mock KeyguardManager mKeyguardManager;
     @Mock UiModeManager mUiModeManager;
     @Mock WallpaperManager mWallpaperManager;
+    @Mock ConnectivityManager mConnectivityManager;
+    @Mock LocationManager mLocationManager;
+    @Mock TelecomManager mTelecomManager;
 
     private static final ZenDeviceEffects NO_EFFECTS = new ZenDeviceEffects.Builder().build();
 
@@ -93,7 +103,12 @@ public class DefaultDeviceEffectsApplierTest {
         mContext.addMockSystemService(KeyguardManager.class, mKeyguardManager);
         mContext.addMockSystemService(UiModeManager.class, mUiModeManager);
         mContext.addMockSystemService(WallpaperManager.class, mWallpaperManager);
+        mContext.addMockSystemService(ConnectivityManager.class, mConnectivityManager);
+        mContext.addMockSystemService(LocationManager.class, mLocationManager);
+        mContext.addMockSystemService(TelecomManager.class, mTelecomManager);
         when(mWallpaperManager.isWallpaperSupported()).thenReturn(true);
+        Settings.Global.putInt(mContext.getContentResolver(), "zen_effect_airplane_mode_owned", 0);
+        Settings.Global.putInt(mContext.getContentResolver(), "zen_effect_location_owned_user", 0);
 
         mApplier = new DefaultDeviceEffectsApplier(mContext);
         verify(mWallpaperManager).isWallpaperSupported();
@@ -388,4 +403,112 @@ public class DefaultDeviceEffectsApplierTest {
         mApplier.apply(NO_EFFECTS, ORIGIN_APP);
         verify(mWallpaperManager, never()).setWallpaperDimAmount(anyFloat());
     }
+
+    private static final ZenDeviceEffects MINIMIZE_RADIO_USAGE =
+            new ZenDeviceEffects.Builder().setShouldMinimizeRadioUsage(true).build();
+    private static final ZenDeviceEffects DISABLE_LOCATION = new ZenDeviceEffects.Builder()
+            .addExtraEffect(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION)
+            .build();
+
+    private void setAirplaneMode(boolean on) {
+        Settings.Global.putInt(mContext.getContentResolver(), Settings.Global.AIRPLANE_MODE_ON,
+                on ? 1 : 0);
+    }
+
+    @Test
+    public void apply_minimizeRadioUsage_togglesAirplaneMode() {
+        setAirplaneMode(false);
+
+        mApplier.apply(MINIMIZE_RADIO_USAGE, ORIGIN_USER_IN_SYSTEMUI);
+        verify(mConnectivityManager).setAirplaneMode(eq(true));
+
+        setAirplaneMode(true);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+        verify(mConnectivityManager).setAirplaneMode(eq(false));
+    }
+
+    @Test
+    public void apply_minimizeRadioUsage_airplaneModeAlreadyOn_leavesItOn() {
+        setAirplaneMode(true);
+
+        mApplier.apply(MINIMIZE_RADIO_USAGE, ORIGIN_USER_IN_SYSTEMUI);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+
+        verify(mConnectivityManager, never()).setAirplaneMode(anyBoolean());
+    }
+
+    @Test
+    public void apply_minimizeRadioUsage_turnedOffByUser_notTurnedOnAgain() {
+        setAirplaneMode(false);
+        mApplier.apply(MINIMIZE_RADIO_USAGE, ORIGIN_USER_IN_SYSTEMUI);
+        verify(mConnectivityManager).setAirplaneMode(eq(true));
+
+        // The user turns airplane mode off, then an unrelated change re-applies the effects.
+        setAirplaneMode(false);
+        mApplier.apply(MINIMIZE_RADIO_USAGE, ORIGIN_APP);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+
+        verifyNoMoreInteractions(mConnectivityManager);
+    }
+
+    @Test
+    public void apply_minimizeRadioUsage_onBootAfterModeEnded_turnsAirplaneModeOff() {
+        setAirplaneMode(false);
+        mApplier.apply(MINIMIZE_RADIO_USAGE, ORIGIN_USER_IN_SYSTEMUI);
+        setAirplaneMode(true);
+
+        // Reboot: the mode ended while the device was off.
+        mApplier = new DefaultDeviceEffectsApplier(mContext);
+        mApplier.apply(NO_EFFECTS, ORIGIN_INIT);
+
+        verify(mConnectivityManager).setAirplaneMode(eq(false));
+    }
+
+    @Test
+    public void apply_minimizeRadioUsage_inCall_waitsForCallToEnd() {
+        setAirplaneMode(false);
+        when(mTelecomManager.isInCall()).thenReturn(true);
+        ArgumentCaptor<BroadcastReceiver> receiverCaptor =
+                ArgumentCaptor.forClass(BroadcastReceiver.class);
+
+        mApplier.apply(MINIMIZE_RADIO_USAGE, ORIGIN_APP);
+
+        verify(mConnectivityManager, never()).setAirplaneMode(anyBoolean());
+        assertThat(getZenLog()).contains("schedule_device_effect: minimizeRadioUsage -> true");
+        verify(mContext).registerReceiver(receiverCaptor.capture(),
+                argThat(filter -> filter.hasAction(TelephonyManager.ACTION_PHONE_STATE_CHANGED)),
+                anyInt());
+
+        when(mTelecomManager.isInCall()).thenReturn(false);
+        receiverCaptor.getValue().onReceive(mContext,
+                new Intent(TelephonyManager.ACTION_PHONE_STATE_CHANGED)
+                        .putExtra(TelephonyManager.EXTRA_STATE, TelephonyManager.EXTRA_STATE_IDLE));
+
+        verify(mConnectivityManager).setAirplaneMode(eq(true));
+        verify(mContext).unregisterReceiver(eq(receiverCaptor.getValue()));
+    }
+
+    @Test
+    public void apply_disableLocation_togglesLocation() {
+        UserHandle user = UserHandle.of(ActivityManager.getCurrentUser());
+        when(mLocationManager.isLocationEnabledForUser(user)).thenReturn(true);
+
+        mApplier.apply(DISABLE_LOCATION, ORIGIN_USER_IN_SYSTEMUI);
+        verify(mLocationManager).setLocationEnabledForUser(eq(false), eq(user));
+
+        when(mLocationManager.isLocationEnabledForUser(user)).thenReturn(false);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+        verify(mLocationManager).setLocationEnabledForUser(eq(true), eq(user));
+    }
+
+    @Test
+    public void apply_disableLocation_locationAlreadyOff_leavesItOff() {
+        UserHandle user = UserHandle.of(ActivityManager.getCurrentUser());
+        when(mLocationManager.isLocationEnabledForUser(user)).thenReturn(false);
+
+        mApplier.apply(DISABLE_LOCATION, ORIGIN_USER_IN_SYSTEMUI);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+
+        verify(mLocationManager, never()).setLocationEnabledForUser(anyBoolean(), any());
+    }
 }

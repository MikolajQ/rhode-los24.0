+        boolean mBluetoothEnabled;
+        boolean mBootCompleted = true;
+        final List<String> mRadioLog;
+        final List<Runnable> mAfterAirplaneModeOff = new ArrayList<>();
+
+        FakeRadiosApplier(Context context, List<String> radioLog) {
+            super(context);
+            mRadioLog = radioLog;
+        }
+
+        @Override
+        protected boolean isWifiEnabled() {
+            return mWifiEnabled;
+        }
+
+        @Override

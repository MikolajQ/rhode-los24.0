+    private static boolean hasExtraEffect(ZenDeviceEffects effects, String extraEffect) {
+        return effects.getExtraEffects().contains(extraEffect);
+    }
+
+    /**
+     * Returns what a radio effect has to do. Re-applying the same effects (e.g. another mode
+     * changed) must not undo a manual change, and keeps a change that is waiting for a call to end.
+     */
+    private int getRadioChange(int pendingChange, boolean shouldApply, boolean wasApplied,
+            String ownedSetting) {
+        if (shouldApply && wasApplied) {
+            return pendingChange;
+        }
+        boolean owned = Settings.Global.getInt(
+                mContext.getContentResolver(), ownedSetting, 0) != 0;
+        if (shouldApply) {
+            // If owned, the mode made the change before a reboot.
+            return owned ? RADIO_NO_CHANGE : RADIO_APPLY;
+        }
+        return owned ? RADIO_UNDO : RADIO_NO_CHANGE;
+    }
+
+    private static void traceScheduledRadioChange(String effect, int change) {
+        if (change != RADIO_NO_CHANGE) {
+            traceScheduleApplyDeviceEffect(effect, change == RADIO_APPLY);
+        }
+    }
+
+    private void applyPendingRadioChanges() {
+        final int airplaneMode = mPendingAirplaneMode;
+        final int wifi = mPendingWifi;
+        final int bluetooth = mPendingBluetooth;
+        mPendingAirplaneMode = RADIO_NO_CHANGE;
+        mPendingWifi = RADIO_NO_CHANGE;
+        mPendingBluetooth = RADIO_NO_CHANGE;
+
+        // Wi-Fi and Bluetooth go off before airplane mode turns on and come back after it is off:
+        // a radio toggled while airplane mode is on is remembered as the user's choice for
+        // airplane mode, and would then stay on (or off) whenever airplane mode is turned on.
+        if (wifi == RADIO_APPLY || bluetooth == RADIO_APPLY) {
+            runRadioChange(() -> {
+                if (wifi == RADIO_APPLY && mShouldDisableWifi) {
+                    updateWifi(/* disable= */ true);
+                }
+                if (bluetooth == RADIO_APPLY && mShouldDisableBluetooth) {
+                    updateBluetooth(/* disable= */ true);
+                }
+            }, /* afterAirplaneModeOff= */ false);
+        }
+        boolean turnedAirplaneModeOff = false;
+        if (airplaneMode != RADIO_NO_CHANGE) {
+            boolean changed = updateAirplaneModeImmediately(airplaneMode == RADIO_APPLY);
+            turnedAirplaneModeOff = changed && airplaneMode == RADIO_UNDO;
+        }
+        if (wifi == RADIO_UNDO || bluetooth == RADIO_UNDO) {
+            runRadioChange(() -> {
+                // A mode turning them off again may have started while this was waiting.
+                if (wifi == RADIO_UNDO && !mShouldDisableWifi) {
+                    updateWifi(/* disable= */ false);
+                }
+                if (bluetooth == RADIO_UNDO && !mShouldDisableBluetooth) {
+                    updateBluetooth(/* disable= */ false);
+                }
+            }, turnedAirplaneModeOff);
+        }
+    }
+
+    /**
+     * Runs a Wi-Fi or Bluetooth change when those services can take it. While the device is
+     * booting (effects are applied as soon as the configuration is read) it waits for the boot to
+     * complete; right after the mode turned airplane mode off it waits for them to see that.
+     */
+    protected void runRadioChange(Runnable change, boolean afterAirplaneModeOff) {
+        synchronized (mRegisterReceiverLock) {
+            if (!isBootCompleted()) {
+                mRadioChangesAfterBoot.add(change);
+                if (!mIsBootReceiverRegistered) {
+                    mContext.registerReceiver(mRadioChangesAfterBootReceiver,
+                            LOCKED_BOOT_COMPLETED_INTENT_FILTER, Context.RECEIVER_NOT_EXPORTED);
+                    mIsBootReceiverRegistered = true;
+                }
+                return;
+            }
+        }
+        if (afterAirplaneModeOff) {
+            runAfterAirplaneModeOff(change);
+        } else {
+            change.run();
+        }
+    }
+
+    protected void runAfterAirplaneModeOff(Runnable change) {
+        // Keep the device awake until then, e.g. when a schedule ends the mode at night.
+        PowerManager.WakeLock wakeLock = mPowerManager.newWakeLock(
+                PowerManager.PARTIAL_WAKE_LOCK, RADIO_RESTORE_WAKE_LOCK_TAG);
+        wakeLock.acquire(RADIO_RESTORE_DELAY_MS * 2);
+        mContext.getMainThreadHandler().postDelayed(() -> {
+            try {
+                change.run();
+            } finally {
+                if (wakeLock.isHeld()) {
+                    wakeLock.release();
+                }
+            }
+        }, RADIO_RESTORE_DELAY_MS);
+    }
+
+    protected boolean isBootCompleted() {
+        return "1".equals(SystemProperties.get("sys.boot_completed"));
+    }
+
+    private final BroadcastReceiver mRadioChangesAfterBootReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            List<Runnable> changes;
+            synchronized (mRegisterReceiverLock) {
+                if (!mIsBootReceiverRegistered) {
+                    return;
+                }
+                mIsBootReceiverRegistered = false;
+                mContext.unregisterReceiver(this);
+                changes = new ArrayList<>(mRadioChangesAfterBoot);
+                mRadioChangesAfterBoot.clear();
+            }
+            Binder.withCleanCallingIdentity(() -> changes.forEach(Runnable::run));
+        }
+    };
+
+    /** Returns whether airplane mode was changed. */
+    private boolean updateAirplaneModeImmediately(boolean enable) {
+        return Binder.withCleanCallingIdentity(() -> {
             try {
                 ContentResolver cr = mContext.getContentResolver();
                 boolean airplaneModeOn =
                         Settings.Global.getInt(cr, Settings.Global.AIRPLANE_MODE_ON, 0) != 0;
                 if (enable) {
                     if (airplaneModeOn) {
-                        return;
+                        return false;
                     }
                     traceApplyDeviceEffect("minimizeRadioUsage", true);
                     Settings.Global.putInt(cr, AIRPLANE_MODE_OWNED_SETTING, 1);
                     mConnectivityManager.setAirplaneMode(true);
+                    return true;
                 } else {
                     if (Settings.Global.getInt(cr, AIRPLANE_MODE_OWNED_SETTING, 0) == 0) {
-                        return;
+                        return false;
                     }
                     Settings.Global.putInt(cr, AIRPLANE_MODE_OWNED_SETTING, 0);
                     // The user may have turned it off already while the mode was active.
                     if (airplaneModeOn) {
                         traceApplyDeviceEffect("minimizeRadioUsage", false);
                         mConnectivityManager.setAirplaneMode(false);
+                        return true;
                     }
+                    return false;
                 }
             } catch (Exception e) {
                 Slog.e(TAG, "Could not change airplane mode", e);
+                return false;
             }
         });
     }
 
-    private final BroadcastReceiver mAirplaneModeWhenCallEnds = new BroadcastReceiver() {
+    private final BroadcastReceiver mRadioChangesWhenCallEnds = new BroadcastReceiver() {
         @Override
         public void onReceive(Context context, Intent intent) {
             if (TelephonyManager.EXTRA_STATE_IDLE.equals(
                     intent.getStringExtra(TelephonyManager.EXTRA_STATE))
                     && (mTelecomManager == null || !mTelecomManager.isInCall())) {
                 unregisterPhoneStateReceiver();
-                updateAirplaneModeImmediately(mPendingAirplaneMode);
+                applyPendingRadioChanges();
             }
         }
     };
 
+    private void updateWifi(boolean disable) {
+        updateRadio("disableWifi", WIFI_OWNED_SETTING, disable, this::isWifiEnabled,
+                this::setWifiEnabled);
+    }
+
+    private void updateBluetooth(boolean disable) {
+        updateRadio("disableBluetooth", BLUETOOTH_OWNED_SETTING, disable,
+                this::isBluetoothEnabled, this::setBluetoothEnabled);
+    }
+
+    private void updateRadio(String effect, String ownedSetting, boolean disable,
+            BooleanSupplier isEnabled, Predicate<Boolean> setEnabled) {
+        ContentResolver cr = mContext.getContentResolver();
+        try {
+            if (disable) {
+                if (!isEnabled.getAsBoolean()) {
+                    return;
+                }
+                traceApplyDeviceEffect(effect, true);
+                Settings.Global.putInt(cr, ownedSetting, 1);
+                if (!setEnabled.test(false)) {
+                    Settings.Global.putInt(cr, ownedSetting, 0);
+                    Slog.w(TAG, "Could not apply " + effect);
+                }
+            } else {
+                if (Settings.Global.getInt(cr, ownedSetting, 0) == 0) {
+                    return;
+                }
+                Settings.Global.putInt(cr, ownedSetting, 0);
+                // The user may have turned it on already while the mode was active.
+                if (!isEnabled.getAsBoolean()) {
+                    traceApplyDeviceEffect(effect, false);
+                    setEnabled.test(true);
+                }
+            }
+        } catch (Exception e) {
+            Slog.e(TAG, "Could not change " + effect, e);
+        }
+    }
+
+    protected boolean isWifiEnabled() {
+        WifiManager wifiManager = mContext.getSystemService(WifiManager.class);
+        if (wifiManager == null) {
+            return false;
+        }
+        int state = wifiManager.getWifiState();
+        return state == WifiManager.WIFI_STATE_ENABLED
+                || state == WifiManager.WIFI_STATE_ENABLING;
+    }
+
+    @SuppressWarnings("deprecation") // Allowed for the system.
+    protected boolean setWifiEnabled(boolean enabled) {
+        WifiManager wifiManager = mContext.getSystemService(WifiManager.class);
+        return wifiManager != null && wifiManager.setWifiEnabled(enabled);
+    }
+
+    private BluetoothAdapter getBluetoothAdapter() {
+        BluetoothManager bluetoothManager = mContext.getSystemService(BluetoothManager.class);
+        return bluetoothManager != null ? bluetoothManager.getAdapter() : null;
+    }
+
+    protected boolean isBluetoothEnabled() {
+        BluetoothAdapter adapter = getBluetoothAdapter();
+        if (adapter == null) {
+            return false;
+        }
+        int state = adapter.getState();
+        return state == BluetoothAdapter.STATE_ON || state == BluetoothAdapter.STATE_TURNING_ON;
+    }
+
+    @SuppressWarnings({"deprecation", "MissingPermission"}) // Allowed for the system.
+    protected boolean setBluetoothEnabled(boolean enabled) {
+        BluetoothAdapter adapter = getBluetoothAdapter();
+        return adapter != null && (enabled ? adapter.enable() : adapter.disable());
+    }

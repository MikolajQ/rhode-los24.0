--- a/services/tests/uiservicestests/src/com/android/server/notification/DefaultDeviceEffectsApplierTest.java
+++ b/services/tests/uiservicestests/src/com/android/server/notification/DefaultDeviceEffectsApplierTest.java
@@ -109,6 +109,10 @@ public class DefaultDeviceEffectsApplierTest {
         when(mWallpaperManager.isWallpaperSupported()).thenReturn(true);
         Settings.Global.putInt(mContext.getContentResolver(), "zen_effect_airplane_mode_owned", 0);
         Settings.Global.putInt(mContext.getContentResolver(), "zen_effect_location_owned_user", 0);
+        Settings.Global.putInt(mContext.getContentResolver(),
+                "zen_effect_double_tap_to_wake_owned_user", 0);
+        mContext.getOrCreateTestableResources().addOverride(
+                com.android.internal.R.bool.config_supportDoubleTapWake, true);
 
         mApplier = new DefaultDeviceEffectsApplier(mContext);
         verify(mWallpaperManager).isWallpaperSupported();
@@ -410,6 +414,11 @@ public class DefaultDeviceEffectsApplierTest {
             .addExtraEffect(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION)
             .build();
 
+    private static final ZenDeviceEffects DISABLE_DOUBLE_TAP_TO_WAKE =
+            new ZenDeviceEffects.Builder()
+                    .addExtraEffect(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_DOUBLE_TAP_TO_WAKE)
+                    .build();
+
     private void setAirplaneMode(boolean on) {
         Settings.Global.putInt(mContext.getContentResolver(), Settings.Global.AIRPLANE_MODE_ON,
                 on ? 1 : 0);
@@ -511,4 +520,70 @@ public class DefaultDeviceEffectsApplierTest {
 
         verify(mLocationManager, never()).setLocationEnabledForUser(anyBoolean(), any());
     }
+
+    private void setDoubleTapToWake(boolean on) {
+        Settings.Secure.putIntForUser(mContext.getContentResolver(),
+                Settings.Secure.DOUBLE_TAP_TO_WAKE, on ? 1 : 0, ActivityManager.getCurrentUser());
+    }
+
+    private boolean isDoubleTapToWakeOn() {
+        return Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                Settings.Secure.DOUBLE_TAP_TO_WAKE, 0, ActivityManager.getCurrentUser()) != 0;
+    }
+
+    @Test
+    public void apply_disableDoubleTapToWake_togglesDoubleTapToWake() {
+        setDoubleTapToWake(true);
+
+        mApplier.apply(DISABLE_DOUBLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+        assertThat(isDoubleTapToWakeOn()).isFalse();
+
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
+
+    @Test
+    public void apply_disableDoubleTapToWake_alreadyOff_leavesItOff() {
+        setDoubleTapToWake(false);
+
+        mApplier.apply(DISABLE_DOUBLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+        mApplier.apply(NO_EFFECTS, ORIGIN_USER_IN_SYSTEMUI);
+
+        assertThat(isDoubleTapToWakeOn()).isFalse();
+    }
+
+    @Test
+    public void apply_disableDoubleTapToWake_turnedOnByUser_notTurnedOffAgain() {
+        setDoubleTapToWake(true);
+        mApplier.apply(DISABLE_DOUBLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+
+        // The user turns double tap to wake on, then an unrelated change re-applies the effects.
+        setDoubleTapToWake(true);
+        mApplier.apply(DISABLE_DOUBLE_TAP_TO_WAKE, ORIGIN_APP);
+
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
+
+    @Test
+    public void apply_disableDoubleTapToWake_onBootAfterModeEnded_turnsItOn() {
+        setDoubleTapToWake(true);
+        mApplier.apply(DISABLE_DOUBLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+
+        // Reboot: the mode ended while the device was off.
+        mApplier = new DefaultDeviceEffectsApplier(mContext);
+        mApplier.apply(NO_EFFECTS, ORIGIN_INIT);
+
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
+
+    @Test
+    public void apply_disableDoubleTapToWake_notSupported_doesNothing() {
+        mContext.getOrCreateTestableResources().addOverride(
+                com.android.internal.R.bool.config_supportDoubleTapWake, false);
+        setDoubleTapToWake(true);
+
+        mApplier.apply(DISABLE_DOUBLE_TAP_TO_WAKE, ORIGIN_USER_IN_SYSTEMUI);
+
+        assertThat(isDoubleTapToWakeOn()).isTrue();
+    }
 }

Assisted-by: LLM
---
 res/values-pl/cm_strings.xml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/res/values-pl/cm_strings.xml b/res/values-pl/cm_strings.xml
index f351ae62660..74f72e64118 100644
--- a/res/values-pl/cm_strings.xml
+++ b/res/values-pl/cm_strings.xml
@@ -134,4 +134,10 @@
     <string name="mode_disable_double_tap_to_wake_title">Wyłącz wybudzanie kliknięciem</string>
     <string name="mode_disable_double_tap_to_wake_title_secondary_list">wyłącz wybudzanie kliknięciem</string>
     <string name="mode_disable_double_tap_to_wake_summary">Dwukrotne kliknięcie ekranu nie wybudza urządzenia, gdy tryb jest aktywny</string>
+    <string name="mode_disable_wifi_title">Wyłącz Wi‑Fi</string>
+    <string name="mode_disable_wifi_title_secondary_list">wyłącz Wi‑Fi</string>
+    <string name="mode_disable_wifi_summary">Wi‑Fi pozostaje wyłączone, gdy tryb jest aktywny, także w trybie samolotowym</string>
+    <string name="mode_disable_bluetooth_title">Wyłącz Bluetooth</string>
+    <string name="mode_disable_bluetooth_title_secondary_list">wyłącz Bluetooth</string>
+    <string name="mode_disable_bluetooth_summary">Bluetooth pozostaje wyłączony, gdy tryb jest aktywny, także w trybie samolotowym</string>
 </resources>

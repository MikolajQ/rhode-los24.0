@@ -66,6 +66,14 @@ class ZenModeDisplayEffectPreferenceController extends AbstractZenModePreference
             case "effect_airplane_mode":
                 pref.setChecked(effects.shouldMinimizeRadioUsage());
                 break;
+            case "effect_disable_wifi":
+                pref.setChecked(effects.getExtraEffects().contains(
+                        ZenDeviceEffects.EXTRA_EFFECT_DISABLE_WIFI));
+                break;
+            case "effect_disable_bluetooth":
+                pref.setChecked(effects.getExtraEffects().contains(
+                        ZenDeviceEffects.EXTRA_EFFECT_DISABLE_BLUETOOTH));

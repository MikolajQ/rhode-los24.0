@@ -101,19 +109,32 @@ class ZenModeDisplayEffectPreferenceController extends AbstractZenModePreference
                 case "effect_disable_tap_to_wake":
                     updatedEffects.setShouldDisableTapToWake(allow);
                     break;
+                case "effect_disable_wifi":
+                    setExtraEffect(updatedEffects, zenMode,
+                            ZenDeviceEffects.EXTRA_EFFECT_DISABLE_WIFI, allow);
+                    break;
+                case "effect_disable_bluetooth":
+                    setExtraEffect(updatedEffects, zenMode,
+                            ZenDeviceEffects.EXTRA_EFFECT_DISABLE_BLUETOOTH, allow);
+                    break;
                 case "effect_disable_location":
-                    Set<String> extraEffects =
-                            new HashSet<>(zenMode.getDeviceEffects().getExtraEffects());
-                    if (allow) {
-                        extraEffects.add(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION);
-                    } else {
-                        extraEffects.remove(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION);
-                    }
-                    updatedEffects.setExtraEffects(extraEffects);
+                    setExtraEffect(updatedEffects, zenMode,
+                            ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION, allow);
                     break;
             }
             zenMode.setDeviceEffects(updatedEffects.build());
             return zenMode;
         });
     }
+
+    private static void setExtraEffect(ZenDeviceEffects.Builder updatedEffects,
+            ZenMode zenMode, String extraEffect, boolean enabled) {
+        Set<String> extraEffects = new HashSet<>(zenMode.getDeviceEffects().getExtraEffects());
+        if (enabled) {
+            extraEffects.add(extraEffect);
+        } else {
+            extraEffects.remove(extraEffect);
+        }
+        updatedEffects.setExtraEffects(extraEffects);
+    }
 }

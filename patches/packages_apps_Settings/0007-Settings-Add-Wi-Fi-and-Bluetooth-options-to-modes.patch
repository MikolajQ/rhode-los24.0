+    @Test
+    public void testUpdateState_disableWifi() {
+        TwoStatePreference preference = mock(TwoStatePreference.class);
+        ZenMode zenMode = new TestModeBuilder()
+                .setDeviceEffects(new ZenDeviceEffects.Builder()
+                        .addExtraEffect(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_WIFI)
+                        .build())
+                .build();
+
+        ZenModeDisplayEffectPreferenceController controller =
+                new ZenModeDisplayEffectPreferenceController(
+                        mContext, "effect_disable_wifi", mBackend);
+
+        controller.updateZenMode(preference, zenMode);
+
+        verify(preference).setChecked(true);
+    }
+
+    @Test
+    public void testOnPreferenceChange_disableWifi_keepsOtherExtraEffects() {
+        TwoStatePreference preference = mock(TwoStatePreference.class);
+        ZenMode zenMode = new TestModeBuilder()
+                .setDeviceEffects(new ZenDeviceEffects.Builder()
+                        .addExtraEffect(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION)
+                        .build())
+                .build();
+
+        ZenModeDisplayEffectPreferenceController controller =
+                new ZenModeDisplayEffectPreferenceController(
+                        mContext, "effect_disable_wifi", mBackend);
+
+        controller.updateZenMode(preference, zenMode);
+
+        controller.onPreferenceChange(preference, true);
+
+        ArgumentCaptor<ZenMode> captor = ArgumentCaptor.forClass(ZenMode.class);
+        verify(mBackend).updateMode(captor.capture());
+        assertThat(captor.getValue().getDeviceEffects().getExtraEffects())
+                .containsExactly(ZenDeviceEffects.EXTRA_EFFECT_DISABLE_LOCATION,
+                        ZenDeviceEffects.EXTRA_EFFECT_DISABLE_WIFI);
+    }
+

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dmitry Muhomor <muhomor.dmitry@gmail.com>
Date: Wed, 11 Dec 2024 16:18:10 +0200
Subject: [PATCH] lower maximum severity of UNFLAGGED_API lint to INFO

Added APIs aren't flagged on GrapheneOS.

[MikolajQ: Ported to Android 17: the severity rule moved to FilteringReporter, UNEXPORTED_FLAGGED_API stays an error]

Change-Id: Idcd33ae0a70d4d306affddec1862829f8cff4e13
---
 .../com/android/tools/metalava/lint/FilteringReporter.kt   | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/metalava/src/main/java/com/android/tools/metalava/lint/FilteringReporter.kt b/metalava/src/main/java/com/android/tools/metalava/lint/FilteringReporter.kt
index 177e269..69a9034 100644
--- a/metalava/src/main/java/com/android/tools/metalava/lint/FilteringReporter.kt
+++ b/metalava/src/main/java/com/android/tools/metalava/lint/FilteringReporter.kt
@@ -101,10 +101,15 @@ class FilteringReporter(
      */
     private fun computeMaximumSeverity(item: Item, previousItem: Item?, issue: Issues.Issue) =
         when {
+            // Added APIs aren't flagged here, so missing @FlaggedApi is informational only.
+            issue == Issues.UNFLAGGED_API -> {
+                Severity.INFO
+            }
+
             // FlaggedApi issues are always treated as an error even if they do appear in the
             // previously released API because they are being reported because there is a change
             // compared with the previously released API.
-            issue == Issues.UNFLAGGED_API || issue == Issues.UNEXPORTED_FLAGGED_API -> {
+            issue == Issues.UNEXPORTED_FLAGGED_API -> {
                 Severity.ERROR
             }
 

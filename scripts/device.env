# Ustawienia urządzenia wspólne dla sign.sh, upload.sh i notify.sh (skrypty są te same w przepisach a50s i rhode).
# RELEASE_IMAGES — z podpisanego target-files (IMAGES/), bo zawierają otacerts/podpisy zgodne z zipem;
# EXTRA_IMAGES — z $OUT (poza IMAGES/ target-files, bez otacerts). Zmieniać razem z urządzeniem.
# Wersja LineageOS: nazwa zipa (sign.sh/upload.sh), kanał Updatera <major>.x/<urządzenie>.json, "version" w JSON-ie
LOS_VERSION=24.0
DEVICE=rhode
REL_REPO=MikolajQ/rhode_releases
RELEASE_IMAGES="boot dtbo vendor_boot"
EXTRA_IMAGES=""
RELEASE_NOTES="boot/dtbo/vendor_boot = obrazy z payload.bin (po podpisaniu): fastboot boot boot.img -> recovery -> Format data -> sideload."
